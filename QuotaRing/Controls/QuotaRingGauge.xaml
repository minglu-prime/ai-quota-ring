<UserControl x:Class="QuotaRing.Controls.QuotaRingGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="66">
    <StackPanel HorizontalAlignment="Center">
        <Grid Width="54" Height="54" HorizontalAlignment="Center">
            <!-- Background track representing 100% total quota -->
            <Ellipse x:Name="TrackEllipse"
                     Width="46" Height="46"
                     StrokeThickness="5"
                     Stroke="#26FFFFFF"
                     Fill="Transparent"/>

            <!-- Full circle used when remaining >= 99.9% -->
            <Ellipse x:Name="FullRingEllipse"
                     Width="46" Height="46"
                     StrokeThickness="5"
                     Stroke="#10B981"
                     Fill="Transparent"
                     Visibility="Collapsed"/>

            <!-- Partial arc representing remaining percentage -->
            <Path x:Name="ArcPath"
                  Width="54" Height="54"
                  StrokeThickness="5"
                  Stroke="#10B981"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"/>

            <!-- Center remaining percentage -->
            <TextBlock x:Name="PercentText"
                       Text="--"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#F8FAFC"/>
        </Grid>

        <TextBlock x:Name="TitleText"
                   Text="5h"
                   Margin="0,4,0,0"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="10.5"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="#CBD5E1"/>

        <TextBlock x:Name="SubText"
                   Text=""
                   Margin="0,1,0,0"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="9.5"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="#94A3B8"/>
    </StackPanel>
</UserControl>
